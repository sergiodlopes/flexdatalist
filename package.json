{
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "build:core": "pnpm --filter flexdatalist build",
    "build:vue": "pnpm --filter flexdatalist-vue build",
    "build:react": "pnpm --filter flexdatalist-react build",
    "build:svelte": "pnpm --filter flexdatalist-svelte build",
    "test": "pnpm --filter flexdatalist test",
    "test:demos": "node tests/demos.test.mjs",
    "docs:build": "node scripts/build-docs.mjs",
    "test:docs-build": "node scripts/build-docs.mjs && node tests/demos.test.mjs --site docs-dist"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "playwright": "1.49.1"
  }
}
