{
  "name": "flexdatalist",
  "description": "Standalone autocomplete/datalist input — no dependencies",
  "version": "3.3.1",
  "type": "module",
  "main": "dist/flexdatalist.umd.cjs",
  "module": "dist/flexdatalist.es.js",
  "types": "src/flexdatalist.d.ts",
  "exports": {
    ".": {
      "types": "./src/flexdatalist.d.ts",
      "import": "./dist/flexdatalist.es.js",
      "require": "./dist/flexdatalist.umd.cjs"
    },
    "./css": "./dist/flexdatalist.css",
    "./standalone": "./src/flexdatalist.js",
    "./standalone/css": "./src/flexdatalist.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/flexdatalist.js",
    "src/flexdatalist.css",
    "llms.txt",
    "src/flexdatalist.d.ts"
  ],
  "style": "dist/flexdatalist.css",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergiodlopes/flexdatalist.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/sergiodlopes/flexdatalist/issues"
  },
  "keywords": [
    "autocomplete",
    "datalist",
    "typeahead",
    "tags",
    "input",
    "vanilla-js"
  ],
  "author": "Sérgio Dinis Lopes",
  "license": "MIT",
  "homepage": "https://github.com/sergiodlopes/flexdatalist",
  "scripts": {
    "build": "vite build",
    "test": "vitest run"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  }
}
